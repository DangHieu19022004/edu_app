# Django Settings
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_HOSTS=*

# Database Settings (for production)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=edu_app_db
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_HOST=localhost
# DB_PORT=5432

# CORS Settings
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Firebase Admin SDK
FIREBASE_CREDENTIALS_PATH=
GEMINI_API_KEY=
OCR_DEVICE=cpu
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# Email settings
# Use console backend in local development; switch to SMTP for real sending.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# MongoDB Settings (MongoEngine)
# Option 1: full URI (recommended for MongoDB Atlas/Compass)
MONGODB_URI=

# Option 2: separate fields (used when MONGODB_URI is empty)
MONGODB_NAME=edu_app
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin
